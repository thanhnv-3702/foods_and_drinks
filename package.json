{
  "scripts": {
    "lint": "sunlint --all --input=src",
    "lint:changed": "sunlint --all --changed-files",
    "lint:security": "sunlint --security --input=src",
    "lint:eslint": "sunlint --all --eslint-integration --input=src",
    "lint:pr": "sunlint --all --pr-mode --fail-on-new-violations --changed-files",
    "lint:all": "sunlint --all --input=. --config .sunlint.json"
  },
  "devDependencies": {
    "@sun-asterisk/sunlint": "^1.3.56",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^9.39.4",
    "typescript": "^6.0.3"
  }
}
